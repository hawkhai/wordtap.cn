{
  "name": "wordtap",
  "version": "0.1.0",
  "description": "面向中文用户的英文点读、查词与朗读 Web 应用",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "homepage": "https://wordtap.cn/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hawkhai/wordtap.cn.git"
  },
  "bugs": {
    "url": "https://github.com/hawkhai/wordtap.cn/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run verify:courses:published && npm run verify:english-vocabulary:published && node --test tools/static-page-design.test.mjs tools/course-cache.test.mjs tools/sentence-reading.test.mjs tools/article-typing.test.mjs tools/reading-phonetics.test.mjs tools/english-vocabulary.test.mjs && node tools/check-downloads.mjs && node tools/verify-responsive-breakpoints.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "postbuild": "node tools/generate-nce-pages.mjs && node tools/generate-shuimu-pages.mjs && node tools/generate-postgraduate-pages.mjs && node tools/generate-pep-english-pages.mjs && node tools/generate-college-english-pages.mjs && node tools/generate-cet-pages.mjs && node tools/generate-kaoyan-english-pages.mjs && node tools/generate-english-vocabulary-pages.mjs && node tools/generate-exam-pages.mjs && node tools/generate-install-guide-pages.mjs && node tools/verify-short-links.mjs && node tools/verify-exam.mjs && node tools/verify-static-design.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "verify": "node tools/verify.mjs",
    "verify:open-source": "node tools/verify-open-source.mjs",
    "verify:shuimu": "node tools/verify-shuimu.mjs",
    "verify:postgraduate": "node tools/verify-postgraduate.mjs",
    "verify:postgraduate:complete": "node tools/verify-postgraduate.mjs --require-complete",
    "ocr:postgraduate": "python tools/ocr-graduate.py",
    "generate:dict": "python tools/convert_ecdict.py",
    "generate:nce": "python scripts/generate_nce_json.py",
    "generate:shuimu": "python tools/generate-shuimu-data.py",
    "generate:postgraduate": "python tools/generate-postgraduate-data.py",
    "fetch:pep-english": "python tools/fetch-pep-english.py --all",
    "generate:pep-english": "node tools/run-pep-generator.mjs",
    "verify:pep-english": "node tools/verify-pep-english.mjs",
    "generate:college-english": "python tools/generate-college-english-data.py",
    "verify:college-english": "python tools/verify-college-english.py --published",
    "verify:college-english:complete": "python tools/verify-college-english.py --published --require-complete",
    "generate:cet": "python tools/generate-cet-data.py",
    "fetch:cet-supplement": "python tools/fetch-cet-supplement.py",
    "inventory:course-sources": "python tools/inventory-course-sources.py",
    "verify:cet": "node tools/verify-cet.mjs",
    "fetch:kaoyan-english": "python tools/fetch-kaoyan-english.py",
    "generate:kaoyan-english": "python tools/generate-kaoyan-english-data.py",
    "verify:kaoyan-english": "node tools/verify-kaoyan-english.mjs",
    "verify:exam": "node tools/verify-exam.mjs",
    "verify:pep-english:complete": "node tools/verify-pep-english.mjs --require-complete",
    "test:pep-english": "python tools/test-pep-english.py && python -m unittest discover -s tools -p test_pep_article_identity.py",
    "review:init:pep-english": "python tools/create-pep-review-ledger.py",
    "review:apply:pep-english": "python tools/apply-pep-reviewed-decisions.py",
    "review:init:college-english": "python tools/create-college-english-review-ledger.py",
    "review:record:college-english": "python tools/record-college-english-review.py",
    "review:apply:college-english": "python tools/generate-college-english-data.py",
    "review:init:reading-layout": "node tools/create-reading-layout-ledger.mjs",
    "verify:short-links": "node tools/verify-short-links.mjs",
    "verify:downloads": "node tools/check-downloads.mjs",
    "verify:responsive": "node tools/verify-responsive-breakpoints.mjs",
    "fetch:english-vocabulary": "python -X utf8 tools/fetch-english-vocabulary.py",
    "generate:english-vocabulary": "python -X utf8 tools/generate-english-vocabulary-data.py",
    "verify:english-vocabulary": "python -X utf8 tools/verify-english-vocabulary.py",
    "test:english-vocabulary": "python -X utf8 -m unittest discover -s tools -p test_english_vocabulary.py && python -X utf8 -m unittest discover -s tools -p test_vocabulary_fetch.py && node --test tools/english-vocabulary.test.mjs",
    "test:reading-phonetics": "node --test tools/reading-phonetics.test.mjs",
    "test:sentence-reading": "node --test tools/sentence-reading.test.mjs",
    "test:article-typing": "node --test tools/article-typing.test.mjs",
    "review:init:articles": "python tools/review-articles.py init",
    "review:inspect:articles": "python tools/review-articles.py inspect",
    "verify:article-review": "python tools/review-articles.py verify",
    "test:article-review": "python -m unittest discover -s tools -p test_article_review.py",
    "review:init:segmentation": "python tools/review-segmentation.py init",
    "review:scan:segmentation": "python tools/review-segmentation.py scan",
    "verify:segmentation": "node tools/verify-courses-published.mjs",
    "verify:segmentation:complete": "node tools/verify-courses-published.mjs --require-complete",
    "test:segmentation": "python -m unittest discover -s tools -p test_segmentation_review.py",
    "verify:article-cleanup": "python tools/cleanup-articles.py check",
    "test:article-cleanup": "python -m unittest discover -s tools -p test_article_cleanup.py",
    "verify:article-review:published": "node tools/verify-courses-published.mjs",
    "test:course-cache": "node --test tools/course-cache.test.mjs",
    "review:scan:spacing": "node tools/spacing-review.mjs scan",
    "review:apply:spacing": "node tools/spacing-review.mjs apply",
    "review:replay:spacing": "node tools/spacing-review.mjs replay",
    "verify:spacing": "node tools/verify-courses-published.mjs",
    "verify:spacing:complete": "node tools/verify-courses-published.mjs --require-complete",
    "test:spacing": "node --test tools/spacing-review.test.mjs",
    "verify:english-vocabulary:published": "node tools/verify-english-vocabulary-published.mjs",
    "verify:courses:published": "node tools/verify-courses-published.mjs",
    "verify:college-english:published": "python tools/verify-college-english.py --published --require-complete",
    "test:review-archive": "python -m unittest discover -s tools -p test_review_archive.py",
    "verify:college-english:history": "python tools/verify-college-english.py --require-complete",
    "verify:browser": "node tools/web-sync.browser.test.mjs"
  },
  "dependencies": {
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^6.0.2",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.1.8"
  }
}
