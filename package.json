{
  "name": "wordtap",
  "version": "0.1.0",
  "description": "WordTap：以英语点读为核心的开源英语学习工具，支持查词、音标、听读、词汇与文章跟打",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "homepage": "https://wordtap.cn/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hawkhai/wordtap.cn.git"
  },
  "bugs": {
    "url": "https://github.com/hawkhai/wordtap.cn/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node tools/verify-published.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "postbuild": "node tools/generate-site.mjs && node tools/update-search-sitemap.mjs && node tools/generate-search-redirects.mjs && node tools/verify-short-links.mjs && node tools/verify-exam.mjs && node tools/verify-static-design.mjs && node tools/verify-site.mjs && node tools/verify-search-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:theme": "node --test tools/theme.test.mjs tools/static-page-design.test.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "node tools/test.mjs",
    "verify": "node tools/verify.mjs",
    "verify:published": "node tools/verify-published.mjs",
    "verify:open-source": "node tools/verify-open-source.mjs",
    "verify:responsive": "node tools/verify-responsive-breakpoints.mjs",
    "verify:browser": "node tools/verify-browser.mjs",
    "test:sentence-reading": "node --test tools/sentence-reading.test.mjs",
    "test:reading-phonetics": "node --test tools/reading-phonetics.test.mjs",
    "test:search-seo": "node --test tools/search-seo.test.mjs",
    "generate:search-redirects": "node tools/generate-search-redirects.mjs",
    "verify:search-seo": "node tools/verify-search-pages.mjs",
    "verify:reading-interaction": "node tools/reading-interaction.browser.mjs"
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^6.0.2",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vue-tsc": "^3.1.8"
  }
}
