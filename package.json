{
  "name": "wordtap",
  "version": "0.1.0",
  "description": "面向中文用户的英文点读、查词与朗读 Web 应用",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "homepage": "https://wordtap.cn/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hawkhai/wordtap.cn.git"
  },
  "bugs": {
    "url": "https://github.com/hawkhai/wordtap.cn/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node tools/verify-published.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "postbuild": "node tools/generate-site.mjs && node tools/verify-short-links.mjs && node tools/verify-exam.mjs && node tools/verify-static-design.mjs && node tools/verify-site.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "node tools/test.mjs",
    "verify": "node tools/verify.mjs",
    "verify:published": "node tools/verify-published.mjs",
    "verify:open-source": "node tools/verify-open-source.mjs",
    "verify:responsive": "node tools/verify-responsive-breakpoints.mjs",
    "verify:browser": "node tools/verify-browser.mjs"
  },
  "dependencies": {
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^6.0.2",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.1.8"
  }
}
